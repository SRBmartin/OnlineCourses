<Window x:Class="OnlineCourses.InformationSystem.Views.Dialogs.ActivityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="440" Height="340"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="148"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Course -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Course:"
                   VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ComboBox  Grid.Row="0" Grid.Column="1"
                   ItemsSource="{Binding Courses}"
                   SelectedItem="{Binding SelectedCourse}"
                   DisplayMemberPath="Name"
                   Margin="0,0,0,8"/>

        <!-- Capture Date -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Capture date:"
                   VerticalAlignment="Center" Margin="0,0,8,8"/>
        <DatePicker Grid.Row="1" Grid.Column="1"
                    SelectedDate="{Binding CaptureTime}"
                    Margin="0,0,0,8"/>

        <!-- Enrollment Count -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Enrollment count:"
                   VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox   Grid.Row="2" Grid.Column="1"
                   Text="{Binding EnrollmentCountText, UpdateSourceTrigger=PropertyChanged}"
                   Padding="4,3" Margin="0,0,0,8"/>

        <!-- Processed Topics -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Processed topics:"
                   VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox   Grid.Row="3" Grid.Column="1"
                   Text="{Binding ProcessedTopicsCountText, UpdateSourceTrigger=PropertyChanged}"
                   Padding="4,3" Margin="0,0,0,8"/>

        <!-- Average Grade -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Average grade (0–10):"
                   VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox   Grid.Row="4" Grid.Column="1"
                   Text="{Binding AverageGradeText, UpdateSourceTrigger=PropertyChanged}"
                   Padding="4,3" Margin="0,0,0,8"/>

        <!-- Validation Error -->
        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="{Binding ValidationError}"
                   Foreground="#CC0000" FontSize="12"
                   TextWrapping="Wrap" Margin="0,0,0,4">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ValidationError}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save"   Width="80" Margin="0,0,8,0"
                    Command="{Binding SaveCommand}" IsDefault="True"/>
            <Button Content="Cancel" Width="80"
                    Command="{Binding CancelCommand}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
