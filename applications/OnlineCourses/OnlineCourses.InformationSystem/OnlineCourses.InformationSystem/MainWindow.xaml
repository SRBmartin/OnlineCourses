<Window x:Class="OnlineCourses.InformationSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Online Courses — Information System"
        Width="1200" Height="750"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <DockPanel LastChildFill="True">

        <ToolBar DockPanel.Dock="Top" Height="36">
            <Button Content="← Undo" Width="72"
                    Command="{Binding UndoCommand}"
                    ToolTip="Undo last action"/>
            <Button Content="Redo →" Width="72"
                    Command="{Binding RedoCommand}"
                    ToolTip="Redo last undone action"/>
        </ToolBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220" MaxWidth="480"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel: Courses -->
            <Grid Grid.Column="0" Margin="8,8,4,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Courses"
                           FontSize="15" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <TextBox Grid.Row="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,4" Margin="0,0,0,6"
                         ToolTip="Search by name, field or lecturer"/>

                <ListView Grid.Row="2"
                          ItemsSource="{Binding CoursesView}"
                          SelectedItem="{Binding SelectedCourse}"
                          BorderThickness="1">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name"     Width="130"
                                            DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Field"    Width="76"
                                            DisplayMemberBinding="{Binding Field}"/>
                            <GridViewColumn Header="Lecturer" Width="90"
                                            DisplayMemberBinding="{Binding Lecturer}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Grid.Row="3" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Add"    Width="64" Padding="4,3" Margin="0,0,8,0"
                            Command="{Binding AddCourseCommand}"/>
                    <Button Content="Edit"   Width="64" Padding="4,3" Margin="0,0,8,0"
                            Command="{Binding EditCourseCommand}"/>
                    <Button Content="Delete" Width="64" Padding="4,3"
                            Command="{Binding DeleteCourseCommand}"/>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#DDDDDD"/>

            <!-- Right panel: Activities + Chart placeholder -->
            <Grid Grid.Column="2" Margin="4,8,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="180"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="2*" MinHeight="140"/>
                </Grid.RowDefinitions>

                <!-- Activities section -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="{Binding ActivitiesHeader}"
                                   FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left"/>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Add Activity"    Width="100" Padding="4,3" Margin="0,0,8,0"
                                    Command="{Binding AddActivityCommand}"/>
                            <Button Content="Edit"            Width="64"  Padding="4,3" Margin="0,0,8,0"
                                    Command="{Binding EditActivityCommand}"/>
                            <Button Content="Delete"          Width="64"  Padding="4,3" Margin="0,0,20,0"
                                    Command="{Binding DeleteActivityCommand}"/>
                            <Button Content="Simulate States" Width="124" Padding="4,3"
                                    Command="{Binding SimulateStatesCommand}"/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ActivitiesView}"
                              SelectedItem="{Binding SelectedActivity}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionUnit="FullRow"
                              CanUserResizeRows="False"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Course"     Width="140"
                                                Binding="{Binding CourseName}"/>
                            <DataGridTextColumn Header="Date"       Width="86"
                                                Binding="{Binding CaptureTime, StringFormat=\{0:d\}}"/>
                            <DataGridTextColumn Header="Enrolled"   Width="72"
                                                Binding="{Binding EnrollmentCount}"/>
                            <DataGridTextColumn Header="Topics"     Width="66"
                                                Binding="{Binding ProcessedTopicsCount}"/>
                            <DataGridTextColumn Header="Avg Grade"  Width="82"
                                                Binding="{Binding AverageGrade, StringFormat=F2}"/>
                            <DataGridTextColumn Header="Status"     Width="*"
                                                Binding="{Binding StatusName}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <GridSplitter Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#DDDDDD"/>

                <!-- IS-5: chart placeholder -->
                <Border Grid.Row="2"
                        Background="#F8F8F8"
                        BorderBrush="#DDDDDD" BorderThickness="1"
                        CornerRadius="3">
                    <TextBlock Text="Status distribution chart  (IS-5)"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#BBBBBB" FontStyle="Italic" FontSize="13"/>
                </Border>
            </Grid>
        </Grid>

    </DockPanel>
</Window>
