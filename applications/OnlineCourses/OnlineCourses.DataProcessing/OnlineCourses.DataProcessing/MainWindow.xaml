<Window x:Class="OnlineCourses.DataProcessing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Online Courses - Data Processing"
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- Top toolbar: date range + strategy + action buttons -->
        <ToolBar DockPanel.Dock="Top" Height="40">
            <Label Content="From:" VerticalAlignment="Center"/>
            <DatePicker SelectedDate="{Binding From}" Width="110" Margin="2 0"/>
            <Label Content="To:" VerticalAlignment="Center"/>
            <DatePicker SelectedDate="{Binding To}" Width="110" Margin="2 0"/>
            <Separator Margin="4 0"/>
            <Label Content="Strategy:" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding StrategyNames}"
                      SelectedItem="{Binding SelectedStrategyName}"
                      Width="200" Margin="2 0"/>
            <Separator Margin="4 0"/>
            <!-- FetchActivitiesCommand loads activities via WCF + adapter -->
            <Button Content="Fetch Data"
                    Command="{Binding FetchActivitiesCommand}"
                    Padding="8 2" Margin="2 0"/>
            <!-- DP-8: RunStatisticsCommand will run selected strategy -->
            <Button Content="Run Statistics"
                    Command="{Binding RunStatisticsCommand}"
                    Padding="8 2" Margin="2 0"/>
            <!-- DP-9: ExportCsvCommand will export statistics result to CSV -->
            <Button Content="Export CSV"
                    Command="{Binding ExportCsvCommand}"
                    Padding="8 2" Margin="2 0"/>
        </ToolBar>

        <!-- Main content: left courses panel + right data/stats panel -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="160"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel: course list -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top"
                           Text="Courses"
                           FontWeight="SemiBold" FontSize="13"
                           Padding="8 6"/>
                <ListView ItemsSource="{Binding Courses}"
                          SelectedItem="{Binding SelectedCourse}"
                          BorderThickness="0 1 1 0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Lecturer}" Foreground="#666" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DDD"/>

            <!-- Right panel: activities and statistics -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="180"/>
                </Grid.RowDefinitions>

                <!-- Activities panel — populated by FetchActivitiesCommand -->
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Activities"
                               FontWeight="SemiBold" FontSize="13"
                               Padding="8 6"/>
                    <Border BorderBrush="#DDD" BorderThickness="1 0 0 0">
                        <Grid>
                            <!-- Placeholder: visible only when no data has been fetched yet -->
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="#999" FontStyle="Italic"
                                       Text="Select a course and date range, then click Fetch Data.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActivitiesText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Dictionary-format data display -->
                            <TextBox Text="{Binding ActivitiesText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Padding="8">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActivitiesText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>
                </DockPanel>

                <GridSplitter Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="#DDD"/>

                <!-- Statistics result area -->
                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Statistics Result"
                               FontWeight="SemiBold" FontSize="13"
                               Padding="8 6"/>
                    <Border BorderBrush="#DDD" BorderThickness="1 1 0 0">
                        <Grid>
                            <!-- Placeholder: visible only when no statistics have been run yet -->
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="#999" FontStyle="Italic"
                                       Text="Select a strategy and click Run Statistics.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatisticsResult}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Statistics result display -->
                            <TextBox Text="{Binding StatisticsResult, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Padding="8">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatisticsResult}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>
                </DockPanel>
            </Grid>
        </Grid>

    </DockPanel>
</Window>
